  {
   "id": "C1",
   "rule": 3,
   "sentence": 86,
   "subject": "How the checks choose versions",
   "entries": {
    "claude": [
     {
      "sentence": 86,
      "quote": "Exact pins in one file, plus a separate drift run on the newest releases. Not a floating gate",
      "subject": "How the checks choose versions",
      "slots": {
       "value": "exact pins",
       "unit": "none",
       "edge": "n/a",
       "default": "none"
