+@app.cell(hide_code=True)
+def _(mo):
+    mo.md(r"""
+    **Hypothesis:** Shipments dip in the second quarter. Outcome: April–June monthly shipment counts sit below the other months.
+    """)
+    return
+
+
+@app.cell(hide_code=True)
+def shipments_per_month(mo, pl, shipments):
+    _monthly = (
+        shipments
+        .group_by(pl.col('ship_date').dt.truncate('1mo').alias('month'))
+        .agg(pl.len().alias('shipments'))
+        .sort('month')
+        .collect()
+    )
+    shipments_per_month = mo.ui.altair_chart(
+        _monthly.plot.line(x='month:T', y='shipments:Q').properties(
+            title='Total shipments per month', width='container'
+        )
+    )
+    shipments_per_month
+    return
+
+
+@app.cell(hide_code=True)
+def _(mo):
+    mo.md(r"""
+    **Facts:** 1,199 shipments over 24 months (Jan 2023 – Dec 2024). Monthly range 35 (Apr 2024) to 60 (Mar 2023).
+    Q2 2023: 54, 55, 50. Q2 2024: 35, 41, 39. Q2 averages 45.7 per month; the other 18 months average 51.4.
+    """)
+    return
+
+
+@app.cell(hide_code=True)
+def _(mo):
+    mo.md(r"""
+    **Hypothesis:** The Q2 dip is concentrated in a few ports. Outcome: a minority of ports show a clearly larger Q2 drop than the rest.
+    """)
+    return
+
+
+@app.cell(hide_code=True)
+def q2_change_by(pl, shipments):
+    def q2_change_by(group):
+        # Q2 shipments per month vs. other-months shipments per month (both years pooled: 6 Q2 months, 18 others)
+        return (
+            shipments
+            .with_columns(pl.col('ship_date').dt.month().is_between(4, 6).alias('is_q2'))
+            .group_by(group)
+            .agg(
+                pl.col('is_q2').sum().truediv(6).alias('q2_per_month'),
+                pl.col('is_q2').not_().sum().truediv(18).alias('rest_per_month'),
+            )
+            .with_columns(
+                pl.col('q2_per_month').truediv(pl.col('rest_per_month')).sub(1).alias('q2_change')
+            )
+            .sort('q2_change')
+            .collect()
+        )
+
+    return (q2_change_by,)
+
+
+@app.cell(hide_code=True)
+def q2_dip_by_port(alt, mo, q2_change_by):
+    q2_dip_by_port = mo.ui.altair_chart(
+        alt.Chart(q2_change_by('port')).mark_bar().encode(
+            x=alt.X('q2_change:Q', axis=alt.Axis(format='%'), title='Q2 vs other months, shipments per month'),
+            y=alt.Y('port:N', sort='x', title=None),
+        ).properties(title='Q2 change by port', width='container')
+    )
+    q2_dip_by_port
+    return
+
+
+@app.cell(hide_code=True)
+def _(mo):
+    mo.md(r"""
+    **Facts:** Q2 vs other months, shipments per month, both years pooled. Seven of 10 ports fall in Q2 and three rise.
+    Largest drops: Ivelholm −43% (5.8 → 3.3), Fennick −35% (6.2 → 4.0), Brackwater −29% (6.6 → 4.7). Next: Dovesend −14%, Hollowmere −10%.
+    Rises: Cindervale +23%, Aldermouth +13%, Glassford +7%. Per-port Q2 counts are small, 20–46 shipments over the six Q2 months.
+    """)
+    return
+
+
