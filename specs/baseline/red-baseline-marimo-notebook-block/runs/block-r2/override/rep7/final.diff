+def q2_dip_by_carrier_type(alt, mo, q2_change_by):
+    q2_dip_by_carrier_type = mo.ui.altair_chart(
+        alt.Chart(q2_change_by('carrier_type')).mark_bar().encode(
+            x=alt.X('q2_change:Q', axis=alt.Axis(format='%'), title='Q2 vs other months, shipments per month'),
+            y=alt.Y('carrier_type:N', sort='x', title=None),
+        ).properties(title='Q2 change by carrier type', width='container')
+    )
+    q2_dip_by_carrier_type
+    return
+
+
+@app.cell(hide_code=True)
+def _(mo):
+    mo.md(r"""
+    **Facts:** Q2 vs other months, shipments per month, both years pooled. Tanker −15% (7.1 → 6.0), container −14% (30.5 → 26.3), bulk −4% (13.8 → 13.3).
+    Container carries the most volume: its drop is 4.2 shipments per month, against 1.1 for tanker and 0.5 for bulk.
