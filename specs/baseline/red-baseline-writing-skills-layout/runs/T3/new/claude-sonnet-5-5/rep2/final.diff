+## Retry or fail fast
+
+```dot
+digraph retry_or_fail_fast {
+    "Call failed or timed out" [shape=ellipse];
+    "curl -sf https://status.example.invalid/health" [shape=plaintext];
+    "Health check exits non-zero?" [shape=diamond];
+    "POST with no Idempotency-Key?" [shape=diamond];
+    "Never retry a POST without an idempotency key" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
+    "Status is 400, 401, 403, 404, 409 or 422?" [shape=diamond];
+    "Fail fast and report" [shape=box];
+    "Retry with backoff (table below)" [shape=box];
+
+    "Call failed or timed out" -> "curl -sf https://status.example.invalid/health";
+    "curl -sf https://status.example.invalid/health" -> "Health check exits non-zero?";
+    "Health check exits non-zero?" -> "Fail fast and report" [label="yes"];
+    "Health check exits non-zero?" -> "POST with no Idempotency-Key?" [label="no"];
+    "POST with no Idempotency-Key?" -> "Never retry a POST without an idempotency key" [label="yes"];
+    "Never retry a POST without an idempotency key" -> "Fail fast and report";
+    "POST with no Idempotency-Key?" -> "Status is 400, 401, 403, 404, 409 or 422?" [label="no"];
+    "Status is 400, 401, 403, 404, 409 or 422?" -> "Fail fast and report" [label="yes"];
+    "Status is 400, 401, 403, 404, 409 or 422?" -> "Retry with backoff (table below)" [label="no"];
+}
+```
