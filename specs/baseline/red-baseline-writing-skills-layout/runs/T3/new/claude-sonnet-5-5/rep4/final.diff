+## Retry or fail fast
+
+```dot
+digraph retry_or_fail_fast {
+    "Call failed or timed out" [shape=ellipse];
+    "curl -sf https://status.example.invalid/health" [shape=plaintext];
+    "Health check exits non-zero?" [shape=diamond];
+    "Is it a POST?" [shape=diamond];
+    "Has an Idempotency-Key header?" [shape=diamond];
+    "Never retry a POST without an idempotency key" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
+    "Is it a 502, 503, 504 or a timeout?" [shape=diamond];
+    "Retry up to 3 times after 1 s, 2 s, 4 s (POST: same key)" [shape=box];
+    "Fail fast and report" [shape=box];
+
+    "Call failed or timed out" -> "curl -sf https://status.example.invalid/health";
+    "curl -sf https://status.example.invalid/health" -> "Health check exits non-zero?";
+    "Health check exits non-zero?" -> "Fail fast and report" [label="yes, service is down"];
+    "Health check exits non-zero?" -> "Is it a POST?" [label="no"];
+    "Is it a POST?" -> "Has an Idempotency-Key header?" [label="yes"];
+    "Is it a POST?" -> "Is it a 502, 503, 504 or a timeout?" [label="no"];
+    "Has an Idempotency-Key header?" -> "Is it a 502, 503, 504 or a timeout?" [label="yes"];
+    "Has an Idempotency-Key header?" -> "Never retry a POST without an idempotency key" [label="no"];
+    "Never retry a POST without an idempotency key" -> "Fail fast and report";
+    "Is it a 502, 503, 504 or a timeout?" -> "Retry up to 3 times after 1 s, 2 s, 4 s (POST: same key)" [label="yes"];
+    "Is it a 502, 503, 504 or a timeout?" -> "Fail fast and report" [label="otherwise"];
+}
+```
