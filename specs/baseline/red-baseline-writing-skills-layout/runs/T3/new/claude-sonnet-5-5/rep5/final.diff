+## Retry or fail fast
+
+```dot
+digraph retry_or_fail_fast {
+    "Call failed or timed out" [shape=ellipse];
+    "curl -sf https://status.example.invalid/health" [shape=plaintext];
+    "Health check exited 0?" [shape=diamond];
+    "Fail fast and report the service is down" [shape=box];
+    "POST with no Idempotency-Key?" [shape=diamond];
+    "Never retry a POST without an idempotency key" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
+    "Timeout, 502, 503 or 504?" [shape=diamond];
+    "Retry up to 3 times after 1 s, 2 s, 4 s, same key" [shape=box];
+    "Fail fast and fix the request" [shape=box];
+
+    "Call failed or timed out" -> "curl -sf https://status.example.invalid/health";
+    "curl -sf https://status.example.invalid/health" -> "Health check exited 0?";
+    "Health check exited 0?" -> "Fail fast and report the service is down" [label="no"];
+    "Health check exited 0?" -> "POST with no Idempotency-Key?" [label="yes"];
+    "POST with no Idempotency-Key?" -> "Never retry a POST without an idempotency key" [label="yes, any failure"];
+    "POST with no Idempotency-Key?" -> "Timeout, 502, 503 or 504?" [label="no"];
+    "Timeout, 502, 503 or 504?" -> "Retry up to 3 times after 1 s, 2 s, 4 s, same key" [label="yes"];
+    "Timeout, 502, 503 or 504?" -> "Fail fast and fix the request" [label="otherwise"];
+}
+```
