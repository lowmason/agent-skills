+## Retry or fail fast
+
+```dot
+digraph retry_or_fail_fast {
+    "Call failed" [shape=doublecircle];
+    "Run health check: curl -sf https://status.example.invalid/health" [shape=box];
+    "Health check exit 0?" [shape=diamond];
+    "POST without Idempotency-Key?" [shape=diamond];
+    "Never retry a POST without an idempotency key" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
+    "Status 400, 401, 403, 404, 409 or 422?" [shape=diamond];
+    "Fail fast and report" [shape=box];
+    "Retry with backoff (same key for POST)" [shape=box];
+
+    "Call failed" -> "Run health check: curl -sf https://status.example.invalid/health";
+    "Run health check: curl -sf https://status.example.invalid/health" -> "Health check exit 0?";
+    "Health check exit 0?" -> "Fail fast and report" [label="no, service down"];
+    "Health check exit 0?" -> "POST without Idempotency-Key?" [label="yes"];
+    "POST without Idempotency-Key?" -> "Never retry a POST without an idempotency key" [label="yes"];
+    "Never retry a POST without an idempotency key" -> "Fail fast and report";
+    "POST without Idempotency-Key?" -> "Status 400, 401, 403, 404, 409 or 422?" [label="no"];
+    "Status 400, 401, 403, 404, 409 or 422?" -> "Fail fast and report" [label="yes"];
+    "Status 400, 401, 403, 404, 409 or 422?" -> "Retry with backoff (same key for POST)" [label="no"];
+}
+```
