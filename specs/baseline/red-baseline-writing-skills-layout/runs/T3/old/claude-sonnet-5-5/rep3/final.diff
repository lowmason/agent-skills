+## Retry or fail fast
+
+```dot
+digraph retry_or_fail_fast {
+    "A call failed or timed out" [shape=ellipse];
+    "curl -sf https://status.example.invalid/health" [shape=plaintext];
+    "Did the health check exit 0?" [shape=diamond];
+    "Is it a POST?" [shape=diamond];
+    "Does it have an Idempotency-Key header?" [shape=diamond];
+    "Never retry a POST without an idempotency key" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
+    "Is the status 400, 401, 403, 404, 409 or 422?" [shape=diamond];
+    "Is it a 502, 503, 504 or a timeout?" [shape=diamond];
+    "Retry (same key for a POST)" [shape=box];
+    "Fail fast and report" [shape=doublecircle];
+
+    "A call failed or timed out" -> "curl -sf https://status.example.invalid/health";
+    "curl -sf https://status.example.invalid/health" -> "Did the health check exit 0?";
+    "Did the health check exit 0?" -> "Fail fast and report" [label="no"];
+    "Did the health check exit 0?" -> "Is it a POST?" [label="yes"];
+    "Is it a POST?" -> "Does it have an Idempotency-Key header?" [label="yes"];
+    "Is it a POST?" -> "Is the status 400, 401, 403, 404, 409 or 422?" [label="no"];
+    "Does it have an Idempotency-Key header?" -> "Never retry a POST without an idempotency key" [label="no"];
+    "Does it have an Idempotency-Key header?" -> "Is the status 400, 401, 403, 404, 409 or 422?" [label="yes"];
+    "Never retry a POST without an idempotency key" -> "Fail fast and report";
+    "Is the status 400, 401, 403, 404, 409 or 422?" -> "Fail fast and report" [label="yes"];
+    "Is the status 400, 401, 403, 404, 409 or 422?" -> "Is it a 502, 503, 504 or a timeout?" [label="no"];
+    "Is it a 502, 503, 504 or a timeout?" -> "Retry (same key for a POST)" [label="yes"];
+    "Is it a 502, 503, 504 or a timeout?" -> "Fail fast and report" [label="no"];
+}
+```
