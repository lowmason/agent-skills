+## Retry or fail fast
+
+```dot
+digraph retry_or_fail_fast {
+    "HTTP call failed or timed out" [shape=ellipse];
+    "curl -sf https://status.example.invalid/health" [shape=plaintext];
+    "Health check exit code 0?" [shape=diamond];
+    "Is it a POST with no Idempotency-Key header?" [shape=diamond];
+    "Never retry a POST without an idempotency key" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
+    "Response is 400, 401, 403, 404, 409 or 422?" [shape=diamond];
+    "Response is 502, 503, 504 or a timeout?" [shape=diamond];
+    "Fail fast: report the service is down" [shape=box];
+    "Fail fast: report the failure" [shape=box];
+    "Fail fast: fix the request" [shape=box];
+    "Retry up to 3 times after 1 s, 2 s, 4 s (honor Retry-After; a POST reuses its key)" [shape=box];
+
+    "HTTP call failed or timed out" -> "curl -sf https://status.example.invalid/health";
+    "curl -sf https://status.example.invalid/health" -> "Health check exit code 0?";
+    "Health check exit code 0?" -> "Fail fast: report the service is down" [label="no"];
+    "Health check exit code 0?" -> "Is it a POST with no Idempotency-Key header?" [label="yes"];
+    "Is it a POST with no Idempotency-Key header?" -> "Never retry a POST without an idempotency key" [label="yes, any failure, timeout and 503 included"];
+    "Never retry a POST without an idempotency key" -> "Fail fast: report the failure";
+    "Is it a POST with no Idempotency-Key header?" -> "Response is 400, 401, 403, 404, 409 or 422?" [label="no"];
+    "Response is 400, 401, 403, 404, 409 or 422?" -> "Fail fast: fix the request" [label="yes"];
+    "Response is 400, 401, 403, 404, 409 or 422?" -> "Response is 502, 503, 504 or a timeout?" [label="no"];
+    "Response is 502, 503, 504 or a timeout?" -> "Retry up to 3 times after 1 s, 2 s, 4 s (honor Retry-After; a POST reuses its key)" [label="yes"];
+    "Response is 502, 503, 504 or a timeout?" -> "Fail fast: report the failure" [label="no"];
+}
+```
