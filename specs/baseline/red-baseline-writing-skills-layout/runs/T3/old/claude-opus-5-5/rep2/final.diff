+## Retry or fail fast
+
+```dot
+digraph retry_or_fail_fast {
+    "Request failed or timed out" [shape=ellipse];
+    "curl -sf https://status.example.invalid/health" [shape=plaintext];
+    "Health check exited 0?" [shape=diamond];
+    "Is it a POST?" [shape=diamond];
+    "Has an Idempotency-Key header?" [shape=diamond];
+    "Never retry a POST without an idempotency key" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
+    "Response is 502, 503, 504 or a timeout?" [shape=diamond];
+    "Fail fast: report the service is down" [shape=box];
+    "Fail fast: report the failure" [shape=box];
+    "Fail fast: fix the request" [shape=box];
+    "Retry up to 3 times, after 1 s, 2 s and 4 s (same key for a POST)" [shape=box];
+
+    "Request failed or timed out" -> "curl -sf https://status.example.invalid/health";
+    "curl -sf https://status.example.invalid/health" -> "Health check exited 0?";
+    "Health check exited 0?" -> "Fail fast: report the service is down" [label="no"];
+    "Health check exited 0?" -> "Is it a POST?" [label="yes"];
+    "Is it a POST?" -> "Has an Idempotency-Key header?" [label="yes"];
+    "Is it a POST?" -> "Response is 502, 503, 504 or a timeout?" [label="no"];
+    "Has an Idempotency-Key header?" -> "Never retry a POST without an idempotency key" [label="no: any failure, timeouts and 503s included"];
+    "Never retry a POST without an idempotency key" -> "Fail fast: report the failure";
+    "Has an Idempotency-Key header?" -> "Response is 502, 503, 504 or a timeout?" [label="yes"];
+    "Response is 502, 503, 504 or a timeout?" -> "Retry up to 3 times, after 1 s, 2 s and 4 s (same key for a POST)" [label="yes"];
+    "Response is 502, 503, 504 or a timeout?" -> "Fail fast: fix the request" [label="no"];
+}
+```
+
