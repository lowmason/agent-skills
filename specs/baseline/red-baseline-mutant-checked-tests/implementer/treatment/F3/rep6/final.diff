diff --git a/tests/test_wordcount.py b/tests/test_wordcount.py
new file mode 100644
index 0000000..88e7257
--- /dev/null
+++ b/tests/test_wordcount.py
@@ -0,0 +1,26 @@
+from wordcount import count_words
+
+
+def test_count_words_skips_comment_lines():
+    assert count_words('# note\nhello world\n') == 2
+
+
+def test_count_words_skips_indented_comment_lines():
+    assert count_words('  \t# note here\nhello\n') == 1
+
+
+def test_count_words_hash_not_first_is_not_comment():
+    assert count_words('hello # world\n') == 3
+
+
+def test_count_words_separated_by_any_whitespace_run():
+    assert count_words('a  b\tc \t d\ne') == 5
+
+
+def test_count_words_empty_and_blank():
+    assert count_words('') == 0
+    assert count_words('  \n\t\n') == 0
+
+
+def test_count_words_hash_without_space_is_comment():
+    assert count_words('#tag one two\nx') == 1
diff --git a/wordcount.py b/wordcount.py
index e69de29..2204f60 100644
--- a/wordcount.py
+++ b/wordcount.py
@@ -0,0 +1,8 @@
+def count_words(text: str) -> int:
+    """Count words in a note, ignoring comment lines (first non-blank char is '#')."""
+    total = 0
+    for line in text.splitlines():
+        if line.lstrip().startswith('#'):
+            continue
+        total += len(line.split())
+    return total
