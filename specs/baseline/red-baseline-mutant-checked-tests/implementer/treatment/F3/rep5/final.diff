new file mode 100644
index 0000000..be0c44e
--- /dev/null
+++ b/tests/test_wordcount.py
@@ -0,0 +1,30 @@
+from wordcount import count_words
+
+
+def test_count_words_skips_comment_lines():
+    assert count_words('# note\nhello world\n') == 2
+
+
+def test_count_words_skips_indented_comment_line():
+    assert count_words('  \t# note here\nhello\n') == 1
+
+
+def test_count_words_counts_hash_inside_a_line():
+    assert count_words('hello # world\n') == 3
+
+
+def test_count_words_splits_on_any_whitespace_run():
+    assert count_words('a  b\t\tc \t d\n') == 4
+
+
+def test_count_words_empty_and_blank_text():
+    assert count_words('') == 0
+    assert count_words('  \n\t\n') == 0
+
+
+def test_count_words_only_comments():
+    assert count_words('# a b\n  # c\n') == 0
+
+
+def test_count_words_without_trailing_newline():
+    assert count_words('# x\none two') == 2
diff --git a/wordcount.py b/wordcount.py
index e69de29..2204f60 100644
--- a/wordcount.py
+++ b/wordcount.py
@@ -0,0 +1,8 @@
+def count_words(text: str) -> int:
+    """Count words in a note, ignoring comment lines (first non-blank char is '#')."""
+    total = 0
+    for line in text.splitlines():
+        if line.lstrip().startswith('#'):
+            continue
+        total += len(line.split())
+    return total
