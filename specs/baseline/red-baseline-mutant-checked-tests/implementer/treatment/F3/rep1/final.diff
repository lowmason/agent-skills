diff --git a/tests/test_wordcount.py b/tests/test_wordcount.py
new file mode 100644
index 0000000..3c0d498
--- /dev/null
+++ b/tests/test_wordcount.py
@@ -0,0 +1,42 @@
+from wordcount import count_words
+
+
+def test_count_words_skips_comment_lines():
+    assert count_words('# note\nhello world\n') == 2
+
+
+def test_indented_comment_line_is_skipped():
+    assert count_words('  \t# indented note\nhello\n') == 1
+
+
+def test_hash_after_first_word_is_not_a_comment():
+    assert count_words('hello # world\n') == 3
+
+
+def test_hash_without_space_is_a_comment():
+    assert count_words('#tag one two\nhello\n') == 1
+
+
+def test_comment_only_text_counts_zero():
+    assert count_words('# a\n  # b\n') == 0
+
+
+def test_empty_and_blank_text_counts_zero():
+    assert count_words('') == 0
+    assert count_words(' \n\t\n') == 0
+
+
+def test_any_run_of_whitespace_separates_words():
+    assert count_words('a  b\tc \t d\ne\r\nf') == 6
+
+
+def test_comment_line_with_carriage_return_is_skipped():
+    assert count_words('# a b\r\nc\r\n') == 1
+
+
+def test_comment_does_not_hide_following_lines():
+    assert count_words('# a\nb\n# c\nd e') == 3
+
+
+def test_unicode_line_separator_does_not_end_a_comment_line():
+    assert count_words('# a b\nc\n') == 1
diff --git a/wordcount.py b/wordcount.py
index e69de29..6fca599 100644
--- a/wordcount.py
+++ b/wordcount.py
@@ -0,0 +1,8 @@
+def count_words(text: str) -> int:
+    """Count whitespace-separated words, ignoring comment lines (first non-blank char is '#')."""
+    total = 0
+    for line in text.split('\n'):
+        if line.lstrip().startswith('#'):
+            continue
+        total += len(line.split())
+    return total
