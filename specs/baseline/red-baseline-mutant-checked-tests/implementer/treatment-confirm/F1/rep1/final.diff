diff --git a/latest.py b/latest.py
index e69de29..1ef83c5 100644
--- a/latest.py
+++ b/latest.py
@@ -0,0 +1,13 @@
+from pathlib import Path
+
+
+def _report_date(path: Path) -> str:
+    for line in path.read_text().splitlines():
+        if line.startswith('date:'):
+            return line[len('date:'):].strip()
+    return ''
+
+
+def latest_report(folder: Path) -> Path:
+    reports = [p for p in folder.glob('*.txt') if p.is_file()]
+    return max(reports, key=_report_date)
diff --git a/tests/test_latest.py b/tests/test_latest.py
new file mode 100644
index 0000000..06dc989
--- /dev/null
+++ b/tests/test_latest.py
@@ -0,0 +1,29 @@
+from latest import latest_report
+
+
+def test_latest_report_returns_the_latest_dated_report(tmp_path):
+    (tmp_path / 'report-a.txt').write_text('title: winter review\ndate: 2024-01-05\n')
+    (tmp_path / 'report-b.txt').write_text('title: spring review\ndate: 2024-03-01\n')
+    assert latest_report(tmp_path) == tmp_path / 'report-b.txt'
+
+
+def test_file_names_carry_no_order(tmp_path):
+    (tmp_path / 'report-a.txt').write_text('date: 2024-03-01\n')
+    (tmp_path / 'report-b.txt').write_text('date: 2024-01-05\n')
+    (tmp_path / 'report-c.txt').write_text('date: 2023-12-31\n')
+    assert latest_report(tmp_path) == tmp_path / 'report-a.txt'
+
+
+def test_date_line_position_does_not_matter(tmp_path):
+    (tmp_path / 'a.txt').write_text('date: 2024-05-01\ntitle: x\n')
+    (tmp_path / 'b.txt').write_text('title: y\nbody\ndate: 2024-02-01\n')
+    assert latest_report(tmp_path) == tmp_path / 'a.txt'
+
+
+def test_non_txt_files_and_subfolders_are_not_reports(tmp_path):
+    (tmp_path / 'a.txt').write_text('date: 2024-01-01\n')
+    (tmp_path / 'b.md').write_text('date: 2025-01-01\n')
+    (tmp_path / 'sub').mkdir()
+    (tmp_path / 'sub' / 'c.txt').write_text('date: 2026-01-01\n')
+    (tmp_path / 'dir.txt').mkdir()
+    assert latest_report(tmp_path) == tmp_path / 'a.txt'
