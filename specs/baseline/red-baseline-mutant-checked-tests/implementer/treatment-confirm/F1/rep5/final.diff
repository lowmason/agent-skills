diff --git a/latest.py b/latest.py
index e69de29..199bacc 100644
--- a/latest.py
+++ b/latest.py
@@ -0,0 +1,15 @@
+from datetime import date
+from pathlib import Path
+
+
+def _report_date(report: Path) -> date:
+    for line in report.read_text().splitlines():
+        if line.startswith('date:'):
+            return date.fromisoformat(line[len('date:'):].strip())
+    raise ValueError(f'no date: line in {report}')
+
+
+def latest_report(folder: Path) -> Path:
+    """Return the .txt report in folder whose date: line holds the latest date."""
+    reports = [p for p in folder.glob('*.txt') if p.is_file()]
+    return max(reports, key=_report_date)
diff --git a/tests/test_latest.py b/tests/test_latest.py
new file mode 100644
index 0000000..84d3bf9
--- /dev/null
+++ b/tests/test_latest.py
@@ -0,0 +1,43 @@
+from latest import latest_report
+
+
+def test_latest_report_returns_the_latest_dated_report(tmp_path):
+    (tmp_path / 'report-a.txt').write_text('title: winter review\ndate: 2024-01-05\n')
+    (tmp_path / 'report-b.txt').write_text('title: spring review\ndate: 2024-03-01\n')
+    assert latest_report(tmp_path) == tmp_path / 'report-b.txt'
+
+
+def test_file_names_carry_no_order(tmp_path):
+    (tmp_path / 'a.txt').write_text('date: 2024-03-01\n')
+    (tmp_path / 'b.txt').write_text('date: 2024-01-05\n')
+    (tmp_path / 'c.txt').write_text('date: 2023-12-31\n')
+    assert latest_report(tmp_path) == tmp_path / 'a.txt'
+
+
+def test_dates_compare_across_years_and_months(tmp_path):
+    (tmp_path / 'x.txt').write_text('date: 2023-12-31\n')
+    (tmp_path / 'y.txt').write_text('date: 2024-01-01\n')
+    (tmp_path / 'z.txt').write_text('date: 2024-01-02\n')
+    (tmp_path / 'w.txt').write_text('date: 2023-12-31\n')
+    assert latest_report(tmp_path) == tmp_path / 'z.txt'
+
+
+def test_date_line_may_be_anywhere_in_the_file(tmp_path):
+    (tmp_path / 'a.txt').write_text('date: 2024-05-01\n')
+    (tmp_path / 'b.txt').write_text('title: t\n\nbody\ndate: 2024-06-01\nmore\n')
+    assert latest_report(tmp_path) == tmp_path / 'b.txt'
+
+
+def test_only_txt_files_directly_in_the_folder_are_reports(tmp_path):
+    (tmp_path / 'a.txt').write_text('date: 2024-01-01\n')
+    (tmp_path / 'b.md').write_text('date: 2025-01-01\n')
+    sub = tmp_path / 'sub'
+    sub.mkdir()
+    (sub / 'c.txt').write_text('date: 2026-01-01\n')
+    assert latest_report(tmp_path) == tmp_path / 'a.txt'
+
+
+def test_a_directory_named_like_a_report_is_skipped(tmp_path):
+    (tmp_path / 'a.txt').write_text('date: 2024-01-01\n')
+    (tmp_path / 'archive.txt').mkdir()
+    assert latest_report(tmp_path) == tmp_path / 'a.txt'
