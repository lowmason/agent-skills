diff --git a/tests/test_wordcount.py b/tests/test_wordcount.py
new file mode 100644
index 0000000..bf0905c
--- /dev/null
+++ b/tests/test_wordcount.py
@@ -0,0 +1,26 @@
+from wordcount import count_words
+
+
+def test_count_words_skips_comment_lines():
+    assert count_words('# note\nhello world\n') == 2
+
+
+def test_indented_comment_line_is_skipped():
+    assert count_words('  \t# note here\nhello\n') == 1
+
+
+def test_hash_after_first_non_blank_is_not_a_comment():
+    assert count_words('hello # world\n') == 3
+
+
+def test_words_separated_by_any_whitespace_run():
+    assert count_words('a  b\tc \t d\n') == 4
+
+
+def test_empty_and_blank_text_has_no_words():
+    assert count_words('') == 0
+    assert count_words('  \n\t\n') == 0
+
+
+def test_words_across_lines_are_counted():
+    assert count_words('one two\nthree\n') == 3
diff --git a/wordcount.py b/wordcount.py
index e69de29..0f5ce08 100644
--- a/wordcount.py
+++ b/wordcount.py
@@ -0,0 +1,8 @@
+def count_words(text: str) -> int:
+    """Count whitespace-separated words, ignoring comment lines."""
+    total = 0
+    for line in text.splitlines():
+        if line.lstrip().startswith('#'):
+            continue
+        total += len(line.split())
+    return total
