+def test_count_words_skips_a_comment_after_spaces():
+    assert count_words('   # note\nhello\n') == 1
+
+
+def test_count_words_skips_a_comment_after_a_tab():
+    assert count_words('\t# note\nhello\n') == 1
+
+
+def test_count_words_skips_a_comment_with_no_blank_after_the_hash():
+    assert count_words('#note here\nhello\n') == 1
+
+
+def test_count_words_skips_a_comment_on_the_last_line():
+    assert count_words('hello\n# last note') == 1
+
+
+def test_count_words_counts_a_hash_after_a_word():
+    assert count_words('hello # world\n') == 3
+
+
+def test_count_words_splits_on_any_run_of_whitespace():
+    assert count_words('one  two\tthree \t four\n\nfive\r\nsix\n') == 6
+
+
+def test_count_words_ignores_whitespace_at_the_ends():
+    assert count_words('  one two  \n') == 2
