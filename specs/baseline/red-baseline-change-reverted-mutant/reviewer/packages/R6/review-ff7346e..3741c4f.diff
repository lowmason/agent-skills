+import re
+
+UNITS = {'B': 1, 'KB': 1024, 'MB': 1024 * 1024}
+SIZE = re.compile(r'([0-9]+)(B|KB|MB)')
+
+
+def to_bytes(text: str) -> int:
+    match = SIZE.fullmatch(text)
+    if match is None:
+        raise ValueError(f'not a size: {text!r}')
+    digits, unit = match.groups()
+    return int(digits) * UNITS[unit]
