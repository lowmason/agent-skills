diff --git a/tests/test_slug.py b/tests/test_slug.py
new file mode 100644
index 0000000..b17202e
--- /dev/null
+++ b/tests/test_slug.py
@@ -0,0 +1,37 @@
+from slug import slugify
+
+
+def test_slugify_collapses_space_runs():
+    assert slugify('a  b') == 'a-b'
+
+
+def test_slugify_lowercases():
+    assert slugify('Hello') == 'hello'
+
+
+def test_slugify_single_space_becomes_one_hyphen():
+    assert slugify('a b') == 'a-b'
+
+
+def test_slugify_collapses_long_space_run():
+    assert slugify('a     b') == 'a-b'
+
+
+def test_slugify_collapses_mixed_whitespace_run():
+    assert slugify('a \t\n b') == 'a-b'
+
+
+def test_slugify_single_tab_and_newline_become_hyphens():
+    assert slugify('a\tb\nc') == 'a-b-c'
+
+
+def test_slugify_collapses_each_run_separately():
+    assert slugify('a  b   c') == 'a-b-c'
+
+
+def test_slugify_leading_and_trailing_runs_become_one_hyphen():
+    assert slugify('  a  ') == '-a-'
+
+
+def test_slugify_lowercases_across_whitespace():
+    assert slugify('Hello  WORLD') == 'hello-world'
