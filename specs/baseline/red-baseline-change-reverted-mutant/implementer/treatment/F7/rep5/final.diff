diff --git a/tests/test_slug.py b/tests/test_slug.py
new file mode 100644
index 0000000..f36c48e
--- /dev/null
+++ b/tests/test_slug.py
@@ -0,0 +1,33 @@
+from slug import slugify
+
+
+def test_slugify_collapses_space_runs():
+    assert slugify('a  b') == 'a-b'
+
+
+def test_slugify_lowercases():
+    assert slugify('Hello') == 'hello'
+
+
+def test_slugify_single_space():
+    assert slugify('a b') == 'a-b'
+
+
+def test_slugify_collapses_long_run():
+    assert slugify('a     b') == 'a-b'
+
+
+def test_slugify_collapses_mixed_whitespace_runs():
+    assert slugify('a \t\n b') == 'a-b'
+
+
+def test_slugify_whitespace_other_than_space():
+    assert slugify('a\tb\nc') == 'a-b-c'
+
+
+def test_slugify_run_at_edges_is_one_hyphen():
+    assert slugify('  a  ') == '-a-'
+
+
+def test_slugify_lowercases_across_words():
+    assert slugify('Hello  World') == 'hello-world'
