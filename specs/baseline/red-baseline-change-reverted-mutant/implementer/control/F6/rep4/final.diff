@@ -0,0 +1,18 @@
+from stock import reorder_needed
+
+
+def test_reorder_at_threshold():
+    assert reorder_needed(2, 5) is True
+
+
+def test_reorder_when_level_equals_threshold():
+    assert reorder_needed(5, 5) is True
+
+
+def test_no_reorder_above_threshold():
+    assert reorder_needed(6, 5) is False
+
+
+def test_reorder_at_zero_threshold_boundary():
+    assert reorder_needed(0, 0) is True
+    assert reorder_needed(1, 0) is False
