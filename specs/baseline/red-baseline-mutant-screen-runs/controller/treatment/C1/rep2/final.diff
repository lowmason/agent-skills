diff --git a/bands.py b/bands.py
new file mode 100644
index 0000000..5efcbde
--- /dev/null
+++ b/bands.py
@@ -0,0 +1,14 @@
+SMALL_LIMIT = 500
+MEDIUM_LIMIT = 2000
+
+
+def is_large(grams: int) -> bool:
+    return grams >= MEDIUM_LIMIT
+
+
+def band(grams: int) -> str:
+    if is_large(grams):
+        return 'large'
+    if grams > SMALL_LIMIT:
+        return 'medium'
+    return 'small'
