@@ -0,0 +1,29 @@
+from parking import fee
+
+
+def test_a_short_stay_is_free():
+    assert fee(20) == 0
+
+
+def test_each_started_hour_costs_2():
+    assert fee(150) == 6
+
+
+def test_exactly_30_minutes_is_free():
+    assert fee(30) == 0
+
+
+def test_31_minutes_costs_one_hour():
+    assert fee(31) == 2
+
+
+def test_exactly_one_hour_costs_2():
+    assert fee(60) == 2
+
+
+def test_one_minute_into_the_second_hour_costs_4():
+    assert fee(61) == 4
+
+
+def test_a_zero_minute_stay_is_free():
+    assert fee(0) == 0
