diff --git a/parking.py b/parking.py
new file mode 100644
index 0000000..cb6e30c
--- /dev/null
+++ b/parking.py
@@ -0,0 +1,10 @@
+FREE_MINUTES = 30
+RATE_PER_HOUR = 2
+
+
+def fee(minutes: int) -> int:
+    """Return the fee for a stay of `minutes` whole minutes."""
+    if minutes <= FREE_MINUTES:
+        return 0
+    started_hours = -(-minutes // 60)
+    return RATE_PER_HOUR * started_hours
diff --git a/tests/test_parking.py b/tests/test_parking.py
new file mode 100644
index 0000000..0ed4f8a
--- /dev/null
+++ b/tests/test_parking.py
@@ -0,0 +1,29 @@
+from parking import fee
+
+
+def test_a_short_stay_is_free():
+    assert fee(20) == 0
+
+
+def test_each_started_hour_costs_2():
+    assert fee(150) == 6
+
+
+def test_exactly_30_minutes_is_free():
+    assert fee(30) == 0
+
+
+def test_one_minute_over_30_costs_one_hour():
+    assert fee(31) == 2
+
+
+def test_a_whole_hour_costs_one_hour():
+    assert fee(60) == 2
+
+
+def test_one_minute_into_the_second_hour_costs_two_hours():
+    assert fee(61) == 4
+
+
+def test_zero_minutes_is_free():
+    assert fee(0) == 0
