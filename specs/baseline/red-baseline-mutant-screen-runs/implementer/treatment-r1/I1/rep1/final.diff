diff --git a/parking.py b/parking.py
new file mode 100644
index 0000000..2e1cbb5
--- /dev/null
+++ b/parking.py
@@ -0,0 +1,6 @@
+def fee(minutes: int) -> int:
+    """Stays up to 30 minutes are free; otherwise 2 per started hour."""
+    if minutes <= 30:
+        return 0
+    started_hours = (minutes + 59) // 60
+    return 2 * started_hours
