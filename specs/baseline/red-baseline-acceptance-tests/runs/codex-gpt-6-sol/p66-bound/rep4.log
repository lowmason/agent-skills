jax-cpu = ['jax', 'jaxlib', 'flax', 'optax', 'orbax-checkpoint', 'equinox', 'diffrax', 'e3nn-jax', 'numpy']
"""


@pytest.fixture
def versions():
    return importlib.import_module("versions")


@pytest.fixture
def versions_check():
