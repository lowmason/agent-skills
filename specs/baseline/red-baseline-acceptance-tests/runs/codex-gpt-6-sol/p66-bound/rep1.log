import os
import re
import sys
import tomllib
from pathlib import Path

import pytest


ROOT = Path(__file__).resolve().parents[1]

SAMPLE = """\
[python]
dev = '3.13'

[freeze]
date = 2026-10-19

[packages]
arviz = '1.3.0'
arviz-base = '1.3.1'
arviz-stats = '1.3.3'
arviz-plots = '1.3.2'
numpyro = '0.22.0'
jax = '0.12.0'
jaxlib = '0.11.2'
numpy = '2.5.3'
matplotlib = '3.11.2'
flax = '0.12.10'
optax = '0.2.8'
orbax-checkpoint = '0.12.6'
equinox = '0.13.8'
diffrax = '0.7.2'
e3nn-jax = '0.21.0'
polars = '2.0.0'

[cited]
altair = '6.2'
plotly = '6.8'
optuna = '5.0.0'
great-docs = '0.17.0'

[gates]
snippets = ['arviz', 'arviz-base', 'arviz-stats', 'arviz-plots', 'numpyro', 'jax', 'numpy', 'matplotlib']
jax-cpu = ['jax', 'jaxlib', 'flax', 'optax', 'orbax-checkpoint', 'equinox', 'diffrax', 'e3nn-jax', 'numpy']
"""


def _build(name):
    build_dir = str(ROOT / "build")
    if build_dir not in sys.path:
        sys.path.insert(0, build_dir)
    return importlib.import_module(name)


def _repo(tmp_path, text=SAMPLE):
    versions = _build("versions")
    (tmp_path / "build").mkdir()
    (tmp_path / "skills").mkdir()
    (tmp_path / "build" / "versions.toml").write_text(text)
    versions.sync(tmp_path)
    return tmp_path


def _findings(root, historical=None):
    return _build("versions_check").check(root, historical=historical)


