def _fixture_entries():
    return [
        {
            "name": "build",
            "dir": "build",
            "with": ["pytest", "numpy", "polars", "pyyaml"],
            "extras": ["arviz>=1.0", "arviz-base", "arviz-stats", "arviz-plots", "numpyro", "jax", "matplotlib"],
