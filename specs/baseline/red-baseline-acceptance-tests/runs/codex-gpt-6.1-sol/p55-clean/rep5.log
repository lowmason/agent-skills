def suite_for(name):
    directory, dependencies, extras, pythons = INVENTORY[name]
    return runner.Suite(
        name=name,
        dir=directory,
        deps=("pytest", *dependencies),
        extras=extras,
        pythons=pythons,
    )


def fixture_data():
    return {
