        pytest.skip("The spec's historical commit 456e3fb is unavailable")
    after = (ROOT / "build/run_commit_lints.sh").read_text(encoding="utf-8")
    pattern = r"(?m)^[ \t]*run[ \t]+.+$"
    old_commands = re.findall(pattern, before.stdout)
