    text = (ROOT / "CLAUDE.md").read_text(encoding="utf-8")
    blocks = "\n".join(
        re.findall(r"```[^\n]*\n(.*?)```", text, re.DOTALL)
    )
    for token in (
        "test_runtime_support.py",
