# spec: "Every documented invocation in `skills/**/*.md` of a path that resolves to one of the 16 scripts uses the form `uv run <path> [args]`, replacing `python`, `python3`, `uv run --no-project --python 3.13 python`, and `uv run --python 3.13 --with … python`."
# task: 11
def test_repository_invocations_use_plain_uv_run(frontmatter):
    for skill in _skills():
        assert frontmatter.check_invocations(skill) == [], skill
        for markdown, runner, spelling in frontmatter.bundled_invocations(
            skill
        ):
            assert runner == "uv run", (markdown, spelling)
            text = re.sub(
                r"\\\r?\n[ \t]*",
                " ",
                markdown.read_text(encoding="utf-8"),
            )
            candidate_lines = [
                line
                for line in text.splitlines()
                if spelling in line
                and re.search(
                    r"\b(?:python3?|uv[ \t]+run)\b", line
                )
            ]
            assert candidate_lines, (markdown, spelling)
            simple_invocation = re.compile(
                r"\buv[ \t]+run[ \t]+['\"]?"
                + re.escape(spelling)
            )
            assert all(
                simple_invocation.search(line)
                for line in candidate_lines
            ), (markdown, spelling, candidate_lines)


