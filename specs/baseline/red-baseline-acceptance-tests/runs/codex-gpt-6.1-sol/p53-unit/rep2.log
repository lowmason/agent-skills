import tomllib
from datetime import date
from pathlib import Path

import pytest
import yaml


REPO = Path(os.environ.get("PORTABILITY_REPO", Path.cwd())).resolve()

SPEC_KEYS = {
    "name",
    "description",
    "license",
    "compatibility",
    "metadata",
    "allowed-tools",
}
HOST_KEYS = {
    "when_to_use",
