# spec: "Each skill directory carries regular files (never symlinks, which `install.py --copy` refuses) that are byte-identical to the root license files and carry the same names:"
# task: 8
def test_repository_license_mapping_and_copies(provenance):
    skills = _skills()
    names = [skill.name for skill in skills]
    table = provenance.BUNDLED_LICENSES
    assert isinstance(table, dict)
    assert all(
        isinstance(key, str)
        and isinstance(value, tuple)
        and all(isinstance(name, str) for name in value)
        for key, value in table.items()
    )
    assert provenance.bundled_license_violations(REPO, names, table) == []

    expected_roots = {
        "LICENSE", "LICENSE-superpowers", "LICENSE-coding-skills"
    }
    if (REPO / "LICENSE-andorra").exists():
        expected_roots.add("LICENSE-andorra")

    mapping = {"LICENSE": tuple(names), **table}
    assert set(mapping) == expected_roots
    assert set(mapping["LICENSE"]) == set(names)
    assert set(mapping["LICENSE-coding-skills"]) == {
        "bayesian-workflow", "clean-code"
    }

    superpowers = {
        skill.name
        for skill in skills
        if _read_frontmatter(skill).get("metadata", {}).get("source")
        == SOURCE_URL
    }
    assert len(superpowers) == 13
    assert set(mapping["LICENSE-superpowers"]) == superpowers
    if "LICENSE-andorra" in mapping:
        assert set(mapping["LICENSE-andorra"]) == {"bayesian-workflow"}

    assert {
        path.name for path in REPO.glob("LICENSE*")
    } == expected_roots
    for filename, recipients in mapping.items():
        canonical = (REPO / filename).read_bytes()
        for name in recipients:
            copy = REPO / "skills" / name / filename
            assert not copy.is_symlink(), copy
            assert copy.is_file(), copy
            assert copy.read_bytes() == canonical, copy
    for skill in skills:
        expected = {
            filename
            for filename, recipients in mapping.items()
            if skill.name in recipients
        }
        assert {
            path.name for path in skill.glob("LICENSE*")
        } == expected


# spec: "The script stays stdlib-only, so its CLAUDE.md command keeps no `--with`."
# task: 8
def test_provenance_remains_stdlib_only():
    source = (REPO / "build/check_provenance.py").read_text(
        encoding="utf-8"
    )
    tree = ast.parse(source)
    imports = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            imports.update(alias.name.split(".")[0] for alias in node.names)
        elif isinstance(node, ast.ImportFrom):
            assert node.level == 0
            if node.module:
                imports.add(node.module.split(".")[0])
    assert imports <= (
        set(sys.stdlib_module_names)
        | set(sys.builtin_module_names)
        | {"__future__"}
    )
    commands = _section(
        (REPO / "CLAUDE.md").read_text(encoding="utf-8"), "Commands"
    )
    invocations = [
        line
        for line in commands.splitlines()
        if "check_provenance.py" in line
    ]
    assert invocations
    assert all("--with" not in line for line in invocations)


