# spec: "Here 3.X is the highest `requires-python` floor among the scripts that skill invokes."
# task: 12
def test_repository_compatibility_uses_highest_invoked_script_floor(
    frontmatter
):
    for skill in _skills():
        invocations = frontmatter.bundled_invocations(skill)
        if not invocations:
            continue
        floors = []
        for _, runner, spelling in invocations:
            assert runner == "uv run"
            path = frontmatter.resolve_bundled_script(spelling, skill)
            assert path is not None
            metadata, _ = _inline_metadata(
                path.read_text(encoding="utf-8")
            )
            match = re.fullmatch(
                r">=(3\.(?:11|12|13))",
                metadata["requires-python"],
            )
            assert match is not None, path
            floors.append(tuple(map(int, match.group(1).split("."))))
        highest = ".".join(map(str, max(floors)))
        assert _read_frontmatter(skill)["compatibility"] == (
            "Requires uv to run bundled scripts "
            f"(dependencies are declared inline); Python {highest}+."
        ), skill


