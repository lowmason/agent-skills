def _load_module(name, relative_path):
    spec = importlib.util.spec_from_file_location(name, REPO / relative_path)
    assert spec is not None and spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module


@pytest.fixture(scope="session")
def frontmatter():
    return _load_module(
        "portability_acceptance_frontmatter", "build/check_frontmatter.py"
    )


@pytest.fixture(scope="session")
def provenance():
    return _load_module(
        "portability_acceptance_provenance", "build/check_provenance.py"
    )


def _write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    return path


def _skill(parent, name="synthetic", frontmatter=None, body=""):
    values = {
        "name": name,
        "description": "Use when checking a synthetic skill.",
        "license": "MIT",
    }
    if frontmatter is not None:
        values.update(frontmatter)
    directory = parent / name
    _write(
        directory / "SKILL.md",
        "---\n"
        + yaml.safe_dump(values, sort_keys=False)
        + "---\n"
        + body,
    )
    return directory


def _read_frontmatter(directory):
    lines = (directory / "SKILL.md").read_text(encoding="utf-8").splitlines()
    assert lines[0] == "---"
    closing = next(i for i in range(1, len(lines)) if lines[i] == "---")
    return yaml.safe_load("\n".join(lines[1:closing]))


def _skills():
    return sorted(
        directory
        for directory in (REPO / "skills").iterdir()
        if directory.is_dir() and (directory / "SKILL.md").is_file()
    )


def _script_text(dependencies=(), requires_python=">=3.11", payload=None):
    if payload is None:
        payload = "if __name__ == '__main__':\n    pass\n"
    return (
        "#!/usr/bin/env python3\n"
        "# /// script\n"
        f"# requires-python = '{requires_python}'\n"
        "# dependencies = ["
        + ", ".join(f"'{dependency}'" for dependency in dependencies)
        + "]\n"
        "# ///\n\n"
        + payload
    )


def _script(directory, filename="profile.py", text=None):
    return _write(
        directory / "scripts" / filename,
        _script_text() if text is None else text,
    )


def _inline_metadata(text):
    lines = text.splitlines()
    start = lines.index("# /// script")
    end = next(
        i for i in range(start + 1, len(lines)) if lines[i] == "# ///"
    )
    block = lines[start + 1:end]
    assert all(line.startswith("#") for line in block)
    contents = "\n".join(
        line.removeprefix("#").removeprefix(" ") for line in block
    )
    return tomllib.loads(contents), contents


def _has_main_guard(path):
    tree = ast.parse(path.read_text(encoding="utf-8"))
    for node in ast.walk(tree):
        if not isinstance(node, ast.If):
            continue
        comparison = node.test
        if (
            not isinstance(comparison, ast.Compare)
            or len(comparison.ops) != 1
            or not isinstance(comparison.ops[0], ast.Eq)
            or len(comparison.comparators) != 1
        ):
            continue
        left, right = comparison.left, comparison.comparators[0]
        pairs = ((left, right), (right, left))
        if any(
            isinstance(a, ast.Name)
            and a.id == "__name__"
            and isinstance(b, ast.Constant)
            and b.value == "__main__"
            for a, b in pairs
        ):
            return True
    return False


def _license_repo(tmp_path):
    repo = tmp_path / "repo"
    names = ["bayesian-workflow", "clean-code", "tech-debt"]
    table = {
        "LICENSE-coding-skills": ("bayesian-workflow", "clean-code"),
    }
    canonical = {
        "LICENSE": b"MIT\n",
        "LICENSE-coding-skills": b"MIT\nSource notice\n",
    }
    repo.mkdir()
    for filename, contents in canonical.items():
        (repo / filename).write_bytes(contents)
    for name in names:
        directory = repo / "skills" / name
        directory.mkdir(parents=True)
        (directory / "LICENSE").write_bytes(canonical["LICENSE"])
    for filename, recipients in table.items():
        for name in recipients:
            (repo / "skills" / name / filename).write_bytes(
                canonical[filename]
            )
    return repo, names, table


def _atoms(value):
    if isinstance(value, dict):
        for nested in value.values():
            yield from _atoms(nested)
    elif isinstance(value, (list, tuple)):
        for nested in value:
            yield from _atoms(nested)
    else:
        yield value


def _section(text, title):
    heading = re.search(
        rf"(?mi)^(#{{1,6}})[ \t]+{re.escape(title)}[ \t]*$",
        text,
    )
    assert heading is not None, f"Missing section: {title}"
    level = len(heading.group(1))
    remainder = text[heading.end():]
    following = re.search(
        rf"(?m)^#{{1,{level}}}[ \t]+", remainder
    )
    return remainder[:following.start()] if following else remainder


