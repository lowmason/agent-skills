        payload = _metadata_payload(text)
        metadata = tomllib.loads(payload)
        assert frontmatter.script_metadata(text) == metadata, name
        assert metadata["requires-python"] in {
            ">=3.11",
            ">=3.12",
            ">=3.13",
        }, name
