    assert not hasattr(frontmatter, "ALLOWED_KEYS")


@pytest.mark.parametrize(
    ("value", "valid"),
    [
        ({}, True),
        ({"author": "Jesse Vincent", "adapted_by": "Lowell Mason"}, True),
