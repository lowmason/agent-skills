from pathlib import Path

import pytest
import yaml


SPEC_KEYS = {
    "name",
    "description",
    "license",
    "compatibility",
    "metadata",
    "allowed-tools",
}
HOST_KEYS = {
    "when_to_use",
    "model",
    "effort",
    "context",
    "disable-model-invocation",
}
SCRIPT_INVENTORY = {
    "bayesian-workflow": (
        "calibration_check.py",
        "check_diagnostics.py",
        "diagnose_model.py",
    ),
    "describe-critique-methodology": ("check_decoupling.py",),
