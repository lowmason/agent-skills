    assert re.search(r"\bschedule\s*:", text)
    match = re.search(
        r"\bcron\s*:\s*(?:'([^']+)'|\"([^\"]+)\"|([^#\n]+))",
        text,
    )
    assert match
    fields = next(value for value in match.groups() if value is not None).split()
    assert len(fields) == 5
