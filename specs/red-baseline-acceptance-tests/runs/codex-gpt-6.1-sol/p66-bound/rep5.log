def write(root, relative, text):
    path = root / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    return path


def track(root):
    subprocess.run(
        ["git", "-C", str(root), "add", "--all"],
        check=True,
        capture_output=True,
        text=True,
    )


@pytest.fixture
