    for index, arg in enumerate(argv):
        if arg in ("-o", "--output-file"):
            Path(argv[index + 1]).write_text(text, encoding="utf-8")
        elif arg.startswith("--output-file="):
            Path(arg.split("=", 1)[1]).write_text(text, encoding="utf-8")
    print(text, end="")
    raise SystemExit(0)

