#!/usr/bin/env bash
# Prove that a task's focused tests catch each of its mutants, and keep the
# proof in a run file in the plan's workspace. A mutant is a small patch that
# makes the task's code wrong in a way a person could plausibly write. The
# script runs the test command once with no patch (the baseline), then once
# with each patch applied, and prints each verdict and the path of the run
# file.
#
# The mutants are the workspace's task-<N>-mutant-<K>.patch files, K a
# positive whole number with no leading zero, each the output of
# `git diff -- <file>` for one edit to the task's code. They run in K order. A
# withdrawn mutant, renamed task-<N>-mutant-<K>.patch.withdrawn, is not read.
#
# In order:
#   1. Recover. <workspace>/mutant-active exists only while a patch is
#      applied: its first line is the patch's file name and the rest is the
#      patch text, so a later run can reverse it even when the patch file is
#      gone. A run killed with a patch applied leaves the marker behind, and
#      the next run reverses that patch first and notes it in its run file.
#   2. Check BASE. It must resolve to a commit
#      (`git rev-parse --verify --quiet "<BASE>^{commit}"`) that is an ancestor
#      of HEAD (a BASE equal to HEAD is allowed). The run file records its
#      full sha. This runs after the recovery, which never needs BASE, so a
#      bad BASE never leaves a killed run's patch applied, and before the
#      dirty-tree refusal.
#   3. Refuse a tree that `git status --porcelain --untracked-files=normal`
#      lists anything for, so a reverse can never undo a person's edit.
#   4. Stop when a patch reverses cleanly (`git apply -R --check`): it is
#      already in HEAD, so a mutant reached a commit.
#   5. Run the baseline. A failing baseline stops the run before any patch,
#      because every mutant would then look caught.
#   6. Each patch. One that touches a test or fixture file (test_*.py,
#      *_test.py, conftest.py, *.test.*, *.spec.*, or a path under a tests/,
#      test/ or fixtures/ directory) is INVALID and never applied, and so is
#      one that `git apply --check` refuses. Otherwise the script writes the
#      marker, applies the patch, runs the command, reverses the patch and
#      removes the marker.
#   7. The revert: the task's code put back as it was at BASE, so the run file
#      shows which tests need the task's change. Its paths are those that
#      changed from BASE to HEAD (`git diff --no-renames`, so a rename is a
#      deletion and an addition), less the test and fixture files and the
#      project config files, which stay at HEAD: pyproject.toml, uv.lock,
#      uv.toml, .python-version, requirements*.txt, setup.cfg, pytest.ini and
#      tox.ini, matched by base name at any depth. The paths are listed before
#      the baseline, so the bytecode purge covers them from the first run.
#      With no path left, nothing runs. Otherwise `git diff --no-renames
#      --binary HEAD BASE` over those paths goes to
#      <workspace>/task-<N>-revert.patch, which each run overwrites and keeps.
#      That diff also takes --no-color, --no-ext-diff, --no-textconv and the
#      a/ and b/ prefixes, so the user's git config cannot change the patch.
#      It runs as a patch does in step 6, with the marker and the mutants' time
#      limit, and with --continue-on-collection-errors added for it alone, so
#      a test file that cannot load hides no other file's tests. It gets no
#      verdict, and it never changes the result line, a mutant line, the tests
#      section or the exit status.
# After the baseline and after each reverse, tracked files must equal HEAD
# (`git diff --quiet HEAD`). Untracked files are not compared, because tests
# leave caches.
#
# Verdicts. Exit 0 is SURVIVED. Exit 1 with at least one failed test in the
# run's JUnit report is CAUGHT: a <testcase> that holds a <failure> or an
# <error>, except pytest's collection-failure and internal-error <error>s,
# which a command that turns every failure into exit 1 would otherwise read
# as a catch. Any other result is INVALID, exit 1 with no report or no failed
# test in it included, so a runner other than pytest can never produce a
# false catch. Every run, the baseline included, gets a JUnit report at a
# fresh path through PYTEST_ADDOPTS, added to any value already set. A command
# that starts pytest more than once and keeps going after a failing run
# leaves only the last run's report, so a catch by an earlier run reads
# INVALID; a command joined with && stops at the failing run. pytest's
# FAILED summary lines are not read: its -r flag is last-wins, so a command
# with -rs prints none. Every run also gets PYTHONDONTWRITEBYTECODE=1, and the
# cached bytecode of each .py file a patch or the revert touches is removed
# before and after every run, so no run loads bytecode older than its source
# and no mutant's bytecode outlives its reverse.
#
# The revert's JUnit report is read one test case at a time, in report order:
# a collection failure is "not loaded", a <failure> or any other test's
# <error> is "failed", a <skipped> is "skipped", and any other test case is
# "passed". pytest's internal error is no test case, so it gets no line. A
# collection-level case (a not loaded file, or a file skipped at its top) has
# no classname, so its line gives the name alone.
#
# Each mutant's run has a time limit: ten times the baseline's whole seconds,
# plus 60, or MUTANT_RUN_TIMEOUT (whole seconds) when it is set. A run past its
# limit is INVALID, and its whole process tree is killed, so no process it
# started keeps running.
#
# The command runs from the current directory, as a background job that the
# script waits on, so a TERM, INT or HUP is handled at once: the command's
# process tree is killed, the applied patch is reversed, the marker is
# removed, and the script exits 143, 130 or 129 with no run file. As a
# background job, the command reads /dev/null as stdin. It stays in the
# script's process group, so a signal sent to that group reaches it too.
#
# A non-interactive bash starts a background job with SIGINT and SIGQUIT
# ignored, and `trap - INT QUIT` in the job sets them back on bash 5 but not
# on bash 3.2. So perl sets both to their defaults and then runs the command
# in its own place, and a suite that needs either one passes here as it does
# in the foreground. Not `set -m`: it would move the command into a process
# group of its own, out of reach of a signal sent to the script's group. Not
# `env --default-signal`: it is GNU-only. perl ships with macOS, where shasum
# is itself a perl script, and with Debian and Ubuntu as an essential
# package. A command that cannot start exits 127 when it is not found and
# 126 otherwise, as under bash. Without perl on PATH, every run exits 127,
# the baseline first, with an output that names perl.
#
# Every git call runs from the top of the working tree, so a patch applies
# from any subdirectory.
#
# Run file: task-<N>-mutants.log for a task's first run, task-<N>-mutants-<K>.log
# for run K = 2, 3 and so on (the smallest K whose file does not exist). It is
# written once, at the end. Until then each command's output waits in a
# temporary file in the workspace, mutant-run.<random>. A killed run, or one
# that stops because the command changed a tracked file, leaves those files
# behind.
#   mutant-run: Task <N>, run <K>
#   command: <the command, rendered the way a person would type it>
#   head: <the full sha of HEAD>
#   base: <the full sha of BASE>
#   tree: clean
#   result: caught <c>, survived <s>, invalid <i>
#   note: reversed <patch file name>, left applied by a killed run
#   revert: <one of the forms below>
#   --- mutants ---
#   mutant <K>: <CAUGHT|SURVIVED|INVALID> exit <status, or - when nothing ran> sha256 <hex>[ tests: <id> ...][ reason: <why>]
#   --- tests ---
#   test <id>: caught <K>[ <K> ...]
#   --- revert ---
#   path: <each reverted path, in git diff order>
#   sha256: <hex of the revert patch file>
#   failed <id>: <the first line of the failure's message>
#   not loaded <name>: <the cause line>
#   skipped <id, or name for a file skipped at its top>: <the skip reason>
#   passed <id>
#   --- output: baseline ---
#   <the baseline's output>
#   --- output: mutant <K> ---
#   <that mutant's output, for each mutant whose command ran>
#   --- output: revert ---
#   <the revert's output, when its command ran>
# The note line appears only after a recovery. <id> is <classname>::<name>. A
# failing baseline writes the header through the note, with "result: baseline
# failed, exit <n>", then "--- output: baseline ---" and its output only.
#
# The revert line is one of:
#   revert: ran, exit <n>, failed <f>, not loaded <u>, skipped <s>, passed <p>
#   revert: ran, exit <n>, no report
#   revert: timeout after <n>s
#   revert: not applied: <reason>
#   revert: none: no file outside the tests and the project config changed
# The revert section exists when a revert patch was built, and its test case
# lines only for a revert that ran and wrote a report. <name> on a "not
# loaded" line is the collection failure's name: its module's dotted path. A
# "skipped" line for a file skipped at its top (a collection-level skip, such
# as an importorskip there) has no classname either, so it gives that name
# too. The cause line is the last line of the error text that starts with
# "E ", less that prefix and the spaces after it, or else the error's message.
# The first line of a rewritten assert's message gets back the
# "AssertionError: " that pytest takes off it. A skip reason is the <skipped>
# message.
#
# Usage: mutant-run PLAN_FILE TASK_NUMBER BASE -- TEST_COMMAND [ARGS...]
#   TASK_NUMBER is a task ID in task-brief's grammar, as test-run takes it.
#   BASE is the task's base commit, as task-done takes it: any name git
#   resolves to a commit, a short sha included.
# stdout: the result line, each mutant line, the revert line, then "run:
#   <absolute path of the run file>" last. A failing baseline prints the last 5
#   lines of its output, then the result line, then the run line. A refusal
#   prints no run line.
# Exit: 0 when every mutant is CAUGHT; 1 when any is SURVIVED or INVALID; 2 for
#   bad arguments, a bad task or mutant number, a BASE that is not a commit or
#   not an ancestor of HEAD, a dirty tree, no mutants, a mutant already in
#   HEAD, or a tree the script could not restore; 3 for a
#   failing baseline; 143, 130 or 129 after TERM, INT or HUP, once the applied
#   patch is reversed. sdd-repo's and sdd-workspace's exit 2 pass through.
#
# Callers: the SDD implementer and controller, and executing-plans' inline
# executor. executing-plans' task-done reads the run file and never runs it.
set -euo pipefail

if [ $# -lt 5 ] || [ "$4" != "--" ]; then
  echo "usage: mutant-run PLAN_FILE TASK_NUMBER BASE -- TEST_COMMAND [ARGS...]" >&2
  exit 2
fi

plan=$1
n=$2
base=$3
shift 4
test_cmd=("$@")
sdd="$(cd "$(dirname "$0")" && pwd)"

# The task number becomes part of a file name, so it must be an ID before any
# path is built. The characters are listed, not ranged, so the locale cannot
# widen them.
id_chars='0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
case "$n" in
  '' | .* | *. | *..* | *[!"$id_chars".]*) bad_id=1 ;;
  *[0-9]*) bad_id=0 ;;
  *) bad_id=1 ;;
esac
if [ "$bad_id" -ne 0 ]; then
  echo "mutant-run: bad task number: $n" >&2
  exit 2
fi

# A leading zero is refused too, so the number never reads as octal.
timeout=${MUTANT_RUN_TIMEOUT:-}
case "$timeout" in
  '') ;;
  0* | *[!0-9]*)
    echo "mutant-run: MUTANT_RUN_TIMEOUT must be a whole number of seconds above 0: $timeout" >&2
    exit 2
    ;;
esac

top=$("$sdd/sdd-repo" --with-commit)
dir=$("$sdd/sdd-workspace" "$plan")
marker="$dir/mutant-active"

# Render the command the way a person would type it.
cmd=""
for a in "$@"; do
  case "$a" in
    *[[:space:]\"\;\|\&]*) cmd="$cmd '$a'" ;;
    *) cmd="$cmd $a" ;;
  esac
done
cmd=${cmd# }

file_sha256() {
  local sum
  if command -v sha256sum > /dev/null 2>&1; then
    sum=$(sha256sum < "$1")
  else
    sum=$(shasum -a 256 < "$1")
  fi
  printf '%s\n' "${sum%% *}"
}

# Print a process and all of its descendants, parents first.
tree_pids() {
  local child
  printf '%s\n' "$1"
  for child in $(pgrep -P "$1" || true); do
    tree_pids "$child"
  done
}

# Send signal $1 to process $2 and all of its descendants. The whole tree is
# listed before any process is signalled: a child whose parent dies first is
# re-parented, and pgrep -P no longer finds it.
kill_tree() {
  local pids
  pids=$(tree_pids "$2")
  # The list is split into words on purpose: one PID per argument.
  kill -"$1" $pids 2> /dev/null || true
}

# Put the tree back as it was before the patch the marker names, using the
# patch text the marker holds, then remove the marker. Set restored to
# "reversed", or to "not applied" for a run killed between writing the marker
# and applying the patch. Return 1, keeping the marker, when the patch neither
# reverses nor applies.
restore_marked() {
  if tail -n +2 "$marker" | git -C "$top" apply -R --check --whitespace=nowarn > /dev/null 2>&1; then
    tail -n +2 "$marker" | git -C "$top" apply -R --whitespace=nowarn || return 1
    restored='reversed'
  elif tail -n +2 "$marker" | git -C "$top" apply --check --whitespace=nowarn > /dev/null 2>&1; then
    restored='not applied'
  else
    return 1
  fi
  rm -f "$marker"
}

# Written whole and then renamed, so a reader never finds half a marker.
write_marker() {
  local tmp
  tmp=$(mktemp "$dir/mutant-run.XXXXXX")
  { printf '%s\n' "$1"; cat "$2"; } > "$tmp"
  mv "$tmp" "$marker"
}

cmd_pid=
watch_pid=
on_signal() {
  trap '' TERM INT HUP
  set +e
  local pid
  for pid in $cmd_pid $watch_pid; do
    kill_tree KILL "$pid"
    wait "$pid" 2> /dev/null
  done
  if [ -e "$marker" ] && ! restore_marked; then
    echo "mutant-run: could not reverse the patch $marker names; restore the tree by hand, then remove the marker" >&2
    exit 2
  fi
  exit "$1"
}
trap 'on_signal 143' TERM
trap 'on_signal 130' INT
trap 'on_signal 129' HUP

# Tracked files must equal HEAD after every run ($1 says which).
check_tree() {
  if ! git -C "$top" diff --quiet HEAD; then
    echo "mutant-run: tracked files differ from HEAD $1, so the test command changed them; the outputs so far are in $dir/mutant-run.*. Changed paths:" >&2
    git -C "$top" diff --name-only HEAD >&2
    exit 2
  fi
}

# 1. Recover.
note=
if [ -e "$marker" ]; then
  left=$(head -n 1 "$marker")
  if ! restore_marked; then
    echo "mutant-run: could not reverse $left, which a killed run left applied ($marker); restore the tree by hand, then remove the marker" >&2
    exit 2
  fi
  if [ "$restored" = 'reversed' ]; then
    note="note: reversed $left, left applied by a killed run"
    echo "mutant-run: reversed $left, left applied by a killed run" >&2
  else
    echo "mutant-run: removed the marker for $left, which a killed run left before applying it" >&2
  fi
fi

# 2. Check BASE: a commit, and an ancestor of HEAD. The recovery never needs
# it, so it ran first. base_sha is the full sha the run file records.
if ! base_sha=$(git -C "$top" rev-parse --verify --quiet "$base^{commit}"); then
  echo "mutant-run: bad BASE: $base" >&2
  exit 2
fi
if ! git -C "$top" merge-base --is-ancestor "$base_sha" HEAD; then
  echo "mutant-run: HEAD is not a descendant of BASE $base" >&2
  exit 2
fi

# 3. Refuse a dirty tree.
changed=$(git -C "$top" status --porcelain --untracked-files=normal)
if [ -n "$changed" ]; then
  echo "mutant-run: the working tree has changed or untracked paths; commit or remove them first, so that no reverse can undo them:" >&2
  printf '%s\n' "$changed" >&2
  exit 2
fi

# 4. Find the patches, in K order.
ks=
for f in "$dir/task-$n-mutant-"*.patch; do
  [ -e "$f" ] || continue
  k=${f##*/}
  k=${k#task-"$n"-mutant-}
  k=${k%.patch}
  case "$k" in
    '' | 0* | *[!0-9]*)
      echo "mutant-run: bad mutant number in ${f##*/}: it must be a whole number above 0, with no leading zero" >&2
      exit 2
      ;;
  esac
  ks="$ks $k"
done
if [ -z "$ks" ]; then
  echo "mutant-run: no mutants for task $n (no task-$n-mutant-<K>.patch in $dir)" >&2
  exit 2
fi
# Each K is digits only, so splitting the list into words is safe.
ks=$(printf '%s\n' $ks | sort -n)

for k in $ks; do
  if git -C "$top" apply -R --check --whitespace=nowarn "$dir/task-$n-mutant-$k.patch" > /dev/null 2>&1; then
    echo "mutant-run: task-$n-mutant-$k.patch is already in HEAD, so a mutant reached a commit; revert it, then run again" >&2
    exit 2
  fi
done

head_sha=$(git -C "$top" rev-parse HEAD)

# Quote a value for PYTEST_ADDOPTS, which pytest splits as a shell would.
sh_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Perl code that sets SIGINT and SIGQUIT to their defaults and then runs its
# arguments as a command, searching PATH, in perl's place. When that fails it
# exits as bash would: 127 for a command not found, 126 for any other reason.
default_signals='$SIG{INT} = $SIG{QUIT} = "DEFAULT";
exec { $ARGV[0] } @ARGV;
print STDERR "mutant-run: $ARGV[0]: $!\n";
exit($!{ENOENT} ? 127 : 126);'

# Run the test command with its output in file $1, a time limit of $2 seconds
# (0: none), and pytest options $3, when given, after the JUnit option. The
# JUnit report goes to $1.xml, a path that does not exist before the run. Set
# run_rc to the command's exit status and timed_out to true or false.
run_command() {
  local out=$1 limit=$2 extra=${3:-} addopts
  rm -f "$out.xml" "$out.timeout"
  purge_bytecode
  addopts="${PYTEST_ADDOPTS:+$PYTEST_ADDOPTS }--junitxml=$(sh_quote "$out.xml")${extra:+ $extra}"
  run_rc=0
  timed_out=false
  # PYTHONDONTWRITEBYTECODE: a timestamp .pyc is checked only by its source's
  # whole-second mtime and size, so a mutant's bytecode written in the second
  # of its reverse would load for the next mutant, and for every later run.
  # The subshell becomes perl, which becomes the command (see the header).
  (
    PYTEST_ADDOPTS=$addopts
    PYTHONDONTWRITEBYTECODE=1
    export PYTEST_ADDOPTS PYTHONDONTWRITEBYTECODE
    exec perl -e "$default_signals" -- "${test_cmd[@]}"
  ) < /dev/null > "$out" 2>&1 &
  cmd_pid=$!
  if [ "$limit" -gt 0 ]; then
    ( sleep "$limit"; : > "$out.timeout"; kill_tree KILL "$cmd_pid" ) > /dev/null 2>&1 &
    watch_pid=$!
  fi
  # A 2> /dev/null keeps bash's "Killed" notice for a killed job off stderr.
  wait "$cmd_pid" 2> /dev/null || run_rc=$?
  cmd_pid=
  # Bytecode the command wrote anyway (compileall ignores
  # PYTHONDONTWRITEBYTECODE) must not outlive the reverse that follows.
  purge_bytecode
  if [ -n "$watch_pid" ]; then
    kill_tree KILL "$watch_pid"
    wait "$watch_pid" 2> /dev/null || true
    watch_pid=
  fi
  if [ -e "$out.timeout" ]; then
    timed_out=true
    rm -f "$out.timeout"
  fi
}

# Print the IDs (<classname>::<name>) of the test cases in JUnit file $1 that
# hold a <failure> or a test's <error>, each once, in report order. A missing file
# prints nothing. Newlines become spaces and each '<' starts a line, so every
# line is one tag, whatever line breaks the file has: a '<' inside text or an
# attribute is always escaped.
failed_tests() {
  [ -f "$1" ] || return 0
  tr '\n<' ' \n' < "$1" | awk '
    function attr(s, key,    i, v) {
      i = index(s, " " key "=\"")
      if (i == 0) return ""
      v = substr(s, i + length(key) + 3)
      v = substr(v, 1, index(v, "\"") - 1)
      gsub(/&lt;/, "<", v); gsub(/&gt;/, ">", v); gsub(/&quot;/, "\"", v); gsub(/&amp;/, "\\&", v)
      return v
    }
    /^testcase[ \t\/>]/ {
      id = attr($0, "classname") "::" attr($0, "name")
      failed = 0
      # The first ">" ends the tag; "/>" there closes the case at once.
      open = substr($0, 1, index($0, ">")) !~ /\/>$/
      next
    }
    # pytest writes a collection error and an internal error as an <error>
    # too. Neither is a test that the mutant made fail, so behind a command
    # that turns every failure into exit 1, neither may read as a catch.
    open && /^error[ \t\/>]/ {
      m = attr($0, "message")
      if (m != "collection failure" && m != "internal error") failed = 1
      next
    }
    open && /^failure[ \t\/>]/ { failed = 1; next }
    /^\/testcase>/ {
      if (open && failed && !(id in seen)) { seen[id] = 1; print id }
      open = 0
    }
  '
}

# Print one line for each test case in the revert's JUnit file $1, in report
# order, as the header's revert section shows them. Each '<' starts a line, as
# in failed_tests, but a newline becomes \001, a byte that XML never holds, so
# the text of an <error> keeps its lines for the cause line.
revert_outcomes() {
  tr '\n<' '\001\n' < "$1" | awk '
    function raw(s, key,    i, v) {
      i = index(s, " " key "=\"")
      if (i == 0) return ""
      v = substr(s, i + length(key) + 3)
      return substr(v, 1, index(v, "\"") - 1)
    }
    function unescape(v) {
      gsub(/&lt;/, "<", v); gsub(/&gt;/, ">", v); gsub(/&quot;/, "\"", v); gsub(/&amp;/, "\\&", v)
      return v
    }
    # The first line of a failure message. pytest takes "AssertionError: "
    # off the message of an assert it rewrote, so it is put back.
    function first_line(m,    i) {
      i = index(m, "&#10;")
      if (i) m = substr(m, 1, i - 1)
      m = unescape(m)
      if (m ~ /^assert /) m = "AssertionError: " m
      return m
    }
    # The last line of the error text that starts with "E ", less that prefix
    # and the spaces after it, or else the message.
    function cause(s,    n, lines, i, c) {
      n = split(substr(s, index(s, ">") + 1), lines, "\001")
      c = ""
      for (i = 1; i <= n; i++) if (lines[i] ~ /^E /) c = lines[i]
      if (c == "") return unescape(raw(s, "message"))
      sub(/^E +/, "", c)
      return unescape(c)
    }
    /^testcase[ \t\/>]/ {
      name = unescape(raw($0, "name"))
      classname = unescape(raw($0, "classname"))
      id = classname "::" name
      outcome = "passed"
      detail = ""
      # The first ">" ends the tag; "/>" there closes the case at once.
      open = substr($0, 1, index($0, ">")) !~ /\/>$/
      if (!open) print "passed " id
      next
    }
    open && /^error[ \t\/>]/ {
      m = raw($0, "message")
      if (m == "internal error") outcome = "none"
      else if (m == "collection failure") { outcome = "not loaded"; detail = cause($0) }
      else if (outcome != "failed") { outcome = "failed"; detail = first_line(m) }
      next
    }
    open && /^failure[ \t\/>]/ {
      if (outcome != "failed") { outcome = "failed"; detail = first_line(raw($0, "message")) }
      next
    }
    open && /^skipped[ \t\/>]/ {
      if (outcome == "passed") { outcome = "skipped"; detail = unescape(raw($0, "message")) }
      next
    }
    # A collection-level case has no classname, so its line gives the name.
    /^\/testcase>/ {
      if (open && outcome == "not loaded") print "not loaded " name ": " detail
      else if (open && outcome == "skipped" && classname == "") print "skipped " name ": " detail
      else if (open && outcome == "passed") print "passed " id
      else if (open && outcome != "none") print outcome " " id ": " detail
      open = 0
    }
  '
}

# Print the counts of revert_outcomes lines on stdin, as the revert line
# shows them.
count_outcomes() {
  awk '
    /^failed / { f++ }
    /^not loaded / { u++ }
    /^skipped / { s++ }
    /^passed / { p++ }
    END { printf "failed %d, not loaded %d, skipped %d, passed %d\n", f, u, s, p }
  '
}

# Print the paths patch $1 touches, one to a line. -z keeps git from quoting
# a path; a rename's two paths each get a line of their own.
patch_paths() {
  git -C "$top" apply --numstat -z "$1" 2> /dev/null | tr '\0' '\n' \
    | awk '{ sub(/^[0-9-]+\t[0-9-]+\t/, ""); if ($0 != "") print }'
}

# Whether path $1 is a test or fixture file: by its base name, or by any of
# its directory parts.
is_test_path() {
  local path=$1
  case "${path##*/}" in
    test_*.py | *_test.py | conftest.py | *.test.* | *.spec.*) return 0 ;;
  esac
  while [ "$path" != "${path#*/}" ]; do
    case "${path%%/*}" in
      tests | test | fixtures) return 0 ;;
    esac
    path=${path#*/}
  done
  return 1
}

# Whether path $1 is a project config file, by its base name at any depth.
# These rebuild or re-sync the environment, or hold the pytest settings that
# the tests at HEAD rely on, so the revert leaves them at HEAD.
is_config_path() {
  case "${1##*/}" in
    pyproject.toml | uv.lock | uv.toml | .python-version | requirements*.txt | setup.cfg | pytest.ini | tox.ini) return 0 ;;
  esac
  return 1
}

# The .py files that any patch touches, one to a line.
py_files=''
for k in $ks; do
  paths=$(patch_paths "$dir/task-$n-mutant-$k.patch") || continue
  while IFS= read -r p; do
    case "$p" in
      *.py) py_files="$py_files$p"$'\n' ;;
    esac
  done <<EOF
$paths
EOF
done

# The revert's paths: each path that changed from BASE to HEAD, less the test
# and fixture files and the project config files, in git diff order. -z keeps
# git from quoting a path. Its .py files join the purge before the baseline.
revert_paths=()
while IFS= read -r -d '' p; do
  if is_test_path "$p" || is_config_path "$p"; then
    continue
  fi
  revert_paths+=("$p")
  case "$p" in
    *.py) py_files="$py_files$p"$'\n' ;;
  esac
done < <(git -C "$top" diff --no-renames --name-only -z "$base_sha" HEAD)

# Remove the cached bytecode of each of those files, before and after every
# run: from its __pycache__ (every optimization level), and from the mirror
# under PYTHONPYCACHEPREFIX when the caller sets one. Python can load a .pyc
# that predates the source it stands for: a timestamp .pyc is checked only by
# the source's whole-second mtime and its size, and an unchecked-hash .pyc not
# at all. A mutant would then never load and would read SURVIVED. Cached
# bytecode is never a tracked file, so the D2 check is unaffected. A fresh
# prefix for every run would also do it, but it recompiles every library.
purge_bytecode() {
  local p src stem
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in
      */*) src="$top/${p%/*}" ;;
      *) src=$top ;;
    esac
    stem=${p##*/}
    stem=${stem%.py}
    rm -f "$src/__pycache__/$stem".*.pyc
    if [ -n "${PYTHONPYCACHEPREFIX:-}" ]; then
      rm -f "$PYTHONPYCACHEPREFIX/${src#/}/$stem".*.pyc
    fi
  done <<EOF
$py_files
EOF
}

# 5. Baseline.
base_out=$(mktemp "$dir/mutant-run.XXXXXX")
start=$SECONDS
run_command "$base_out" 0
base_secs=$((SECONDS - start))
rm -f "$base_out.xml"
base_rc=$run_rc
check_tree 'after the baseline'

# The smallest K whose file does not exist.
next_run_file() {
  run_k=1
  run_file="$dir/task-${n}-mutants.log"
  while [ -e "$run_file" ]; do
    run_k=$((run_k + 1))
    run_file="$dir/task-${n}-mutants-${run_k}.log"
  done
}

# Copy file $1, ending it with a newline when it has none.
cat_lines() {
  cat "$1"
  [ -z "$(tail -c 1 "$1")" ] || echo
}

write_header() {
  printf 'mutant-run: Task %s, run %s\n' "$n" "$run_k"
  printf 'command: %s\n' "$cmd"
  printf 'head: %s\n' "$head_sha"
  printf 'base: %s\n' "$base_sha"
  printf 'tree: clean\n'
  printf '%s\n' "$result"
  [ -z "$note" ] || printf '%s\n' "$note"
}

if [ "$base_rc" -ne 0 ]; then
  result="result: baseline failed, exit $base_rc"
  next_run_file
  {
    write_header
    printf -- '--- output: baseline ---\n'
    cat "$base_out"
  } > "$run_file"
  tail -n 5 "$base_out"
  # A last line with no newline must not run into the result line.
  [ -z "$(tail -c 1 "$base_out")" ] || echo
  rm -f "$base_out"
  printf '%s\n' "$result"
  echo "run: $run_file"
  exit 3
fi

if [ -n "$timeout" ]; then
  limit=$timeout
else
  limit=$((10 * base_secs + 60))
fi

# 6. Each patch.
caught=0
survived=0
invalid=0
mutant_lines=()
ran_ks=()
ran_outs=()
pairs=''
for k in $ks; do
  name="task-$n-mutant-$k.patch"
  patch="$dir/$name"
  sha=$(file_sha256 "$patch")
  status='-'
  verdict='INVALID'
  detail=''
  touched=''
  if ! paths=$(patch_paths "$patch"); then
    detail=' reason: does not apply'
  else
    while IFS= read -r p; do
      if is_test_path "$p"; then
        touched=$p
        break
      fi
    done <<EOF
$paths
EOF
    if [ -n "$touched" ]; then
      detail=" reason: touches a test file: $touched"
    elif ! git -C "$top" apply --check --whitespace=nowarn "$patch" > /dev/null 2>&1; then
      detail=' reason: does not apply'
    else
      write_marker "$name" "$patch"
      if ! git -C "$top" apply --whitespace=nowarn "$patch"; then
        # A refused patch writes nothing, so there is nothing to reverse.
        rm -f "$marker"
        check_tree "after $name did not apply"
        detail=' reason: does not apply'
      else
        out=$(mktemp "$dir/mutant-run.XXXXXX")
        run_command "$out" "$limit"
        if ! restore_marked; then
          echo "mutant-run: could not reverse $name after its run ($marker); restore the tree by hand, then remove the marker" >&2
          exit 2
        fi
        check_tree "after reversing $name"
        ids=$(failed_tests "$out.xml")
        rm -f "$out.xml"
        ran_ks+=("$k")
        ran_outs+=("$out")
        status=$run_rc
        if [ "$timed_out" = true ]; then
          detail=" reason: timeout after ${limit}s"
        elif [ "$run_rc" -eq 0 ]; then
          verdict='SURVIVED'
        elif [ "$run_rc" -eq 1 ] && [ -n "$ids" ]; then
          verdict='CAUGHT'
          detail=" tests: $(printf '%s' "$ids" | tr '\n' ' ')"
          while IFS= read -r id; do
            pairs="$pairs$id"$'\t'"$k"$'\n'
          done <<EOF
$ids
EOF
        elif [ "$run_rc" -eq 1 ]; then
          detail=' reason: no failed test in the JUnit report'
        else
          detail=" reason: exit status $run_rc"
        fi
      fi
    fi
  fi
  case "$verdict" in
    CAUGHT) caught=$((caught + 1)) ;;
    SURVIVED) survived=$((survived + 1)) ;;
    *) invalid=$((invalid + 1)) ;;
  esac
  mutant_lines+=("mutant $k: $verdict exit $status sha256 $sha$detail")
done

# 7. The revert, on the machinery of step 6. The "already in HEAD" check never
# sees it: it is built from HEAD, and its name is not a mutant's.
revert_name="task-$n-revert.patch"
revert_patch="$dir/$revert_name"
revert_sha=
revert_out=
outcomes=
if [ "${#revert_paths[@]}" -eq 0 ]; then
  revert='revert: none: no file outside the tests and the project config changed'
else
  # :(literal) keeps git from reading a glob character in a path as a pattern.
  pathspecs=()
  for p in "${revert_paths[@]}"; do
    pathspecs+=(":(literal)$p")
  done
  # The patch must not depend on the user's git config: color.ui or
  # color.diff "always" would write colour codes, diff.noprefix would drop
  # the a/ and b/ that git apply strips, and diff.external or a textconv
  # driver would write something other than the files' bytes.
  git -C "$top" diff --no-renames --binary --no-color --no-ext-diff --no-textconv \
    --src-prefix=a/ --dst-prefix=b/ HEAD "$base_sha" -- "${pathspecs[@]}" > "$revert_patch"
  revert_sha=$(file_sha256 "$revert_patch")
  revert='revert: not applied: does not apply'
  if git -C "$top" apply --check --whitespace=nowarn "$revert_patch" > /dev/null 2>&1; then
    write_marker "$revert_name" "$revert_patch"
    if ! git -C "$top" apply --whitespace=nowarn "$revert_patch"; then
      # A refused patch writes nothing, so there is nothing to reverse.
      rm -f "$marker"
      check_tree "after $revert_name did not apply"
    else
      revert_out=$(mktemp "$dir/mutant-run.XXXXXX")
      run_command "$revert_out" "$limit" --continue-on-collection-errors
      if ! restore_marked; then
        echo "mutant-run: could not reverse $revert_name after its run ($marker); restore the tree by hand, then remove the marker" >&2
        exit 2
      fi
      check_tree "after reversing $revert_name"
      if [ "$timed_out" = true ]; then
        revert="revert: timeout after ${limit}s"
      elif [ -f "$revert_out.xml" ]; then
        outcomes=$(revert_outcomes "$revert_out.xml")
        revert="revert: ran, exit $run_rc, $(printf '%s\n' "$outcomes" | count_outcomes)"
      else
        revert="revert: ran, exit $run_rc, no report"
      fi
      rm -f "$revert_out.xml"
    fi
  fi
fi

# 8. Write the run file.
result="result: caught $caught, survived $survived, invalid $invalid"
next_run_file
{
  write_header
  printf '%s\n' "$revert"
  printf -- '--- mutants ---\n'
  printf '%s\n' "${mutant_lines[@]}"
  printf -- '--- tests ---\n'
  printf '%s' "$pairs" | awk -F '\t' '
    !($1 in ks) { order[++count] = $1; ks[$1] = $2; next }
    { ks[$1] = ks[$1] " " $2 }
    END { for (i = 1; i <= count; i++) print "test " order[i] ": caught " ks[order[i]] }
  '
  if [ -n "$revert_sha" ]; then
    printf -- '--- revert ---\n'
    printf 'path: %s\n' "${revert_paths[@]}"
    printf 'sha256: %s\n' "$revert_sha"
    [ -z "$outcomes" ] || printf '%s\n' "$outcomes"
  fi
  printf -- '--- output: baseline ---\n'
  cat_lines "$base_out"
  i=0
  while [ "$i" -lt "${#ran_ks[@]}" ]; do
    printf -- '--- output: mutant %s ---\n' "${ran_ks[$i]}"
    cat_lines "${ran_outs[$i]}"
    i=$((i + 1))
  done
  if [ -n "$revert_out" ]; then
    printf -- '--- output: revert ---\n'
    cat_lines "$revert_out"
  fi
} > "$run_file"
rm -f "$base_out" ${ran_outs[@]+"${ran_outs[@]}"} ${revert_out:+"$revert_out"}

printf '%s\n' "$result" "${mutant_lines[@]}" "$revert"
echo "run: $run_file"

# 9. Exit.
if [ "$survived" -eq 0 ] && [ "$invalid" -eq 0 ]; then
  exit 0
fi
exit 1
