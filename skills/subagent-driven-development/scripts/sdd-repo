#!/usr/bin/env bash
# Print the top-level directory of the git working tree the SDD and
# executing-plans scripts work in: the current directory's, exactly as
# `git rev-parse --show-toplevel` prints it.
#
# The plan file's location never picks the repository. An executor working in
# a linked worktree often holds an absolute path to a plan that sits in the
# main checkout, and its workspace and commits belong to the worktree it is
# working in. A caller standing outside any repository is in the wrong place,
# and guessing a repository from the plan would act on whichever checkout the
# path points into.
#
# Two refusals, both exit 2 with two lines on stderr:
#   - Outside any working tree, the script stops.
#   - With --with-commit, it also stops in a repository that has no commit
#     yet, for a caller that needs HEAD as a BASE or as a review range.
# Line 1 is one message for both cases. It covers running from the wrong
# directory (where 'git init' is the wrong fix) and a new project that has no
# repository or commit yet. Line 2 is git's own first line, which names the
# real cause when line 1 alone would mislead.
#
# Three callers: sdd-workspace (plain), review-package and executing-plans'
# task-start (both with --with-commit). task-done keeps its own BASE check.
#
# Single source of truth for which repository the scripts work in, so no two
# of them can disagree.
#
# Usage: sdd-repo [--with-commit]
set -euo pipefail

with_commit=false
if [ "${1:-}" = "--with-commit" ]; then
  with_commit=true
  shift
fi

if [ $# -ne 0 ]; then
  echo "usage: sdd-repo [--with-commit]" >&2
  exit 2
fi

if root=$(git rev-parse --show-toplevel 2>/dev/null); then
  if [ "$with_commit" = false ] || git -C "$root" rev-parse --verify --quiet HEAD >/dev/null; then
    printf '%s\n' "$root"
    exit 0
  fi
  said=$(git -C "$root" rev-parse --verify HEAD 2>&1 >/dev/null) || true
else
  said=$(git rev-parse --show-toplevel 2>&1 >/dev/null) || true
fi

# git's own first line always follows the shared message: where git refuses
# a working tree the caller is inside (dubious ownership, git missing from
# PATH, the cwd inside .git), the shared message alone would be wrong, and
# git's line names the real fix.
echo "SDD scripts must run from inside the git working tree you're executing in, with at least one commit (current directory: $PWD). If this is a new project, run 'git init' and make a first commit, then rerun." >&2
echo "git said: ${said%%$'\n'*}" >&2
exit 2
