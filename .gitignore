# macOS
.DS_Store

# Claude Code per-machine settings (not shared)
**/.claude/settings.local.json

# Claude Code personal instructions beside each CLAUDE.md (not shared); guide
# section rules.hierarchy leaves this to the repo, and local-md-ignored checks
# it. Anchored, so install.py's FALLBACK_IGNORES, which mirrors every
# unanchored entry here, needs no new name; a new CLAUDE.md directory adds a line.
/CLAUDE.local.md
/build/CLAUDE.local.md

# Python verification venvs and caches
**/.verify_venv/
**/__pycache__/
*.pyc

# Build-time scratch for recommend-probabilistic-model: extracted CC-BY-NC-ND
# book section indices used only to build/verify citations — never commit.
build/.scratch/

# pytest
.pytest_cache/
.hypothesis/

# SDD workspace — duplicates .sdd/.gitignore's self-ignoring guard on purpose
.sdd/

# Claude Code worktrees live inside the repo, so without this an untracked
# full checkout shows up in the main tree's status and `git add -A` commits it.
.claude/worktrees/

# Upstream skill repos cloned for review/intake comparison — foreign git
# histories, never vendored into this tree. See specs/completed/skill-intake-review-*.md.
review/
